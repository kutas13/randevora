NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Super Admin acil giris bypass anahtari (Supabase Auth bozulursa kullanilir)
# Vercel'de bu env var'i tanimla. Ornek: uzun rastgele bir string.
SUPER_ADMIN_KEY=

# Iyzico Sanal POS (kapora odemeleri icin)
# Sandbox test icin: https://sandbox-merchant.iyzipay.com/auth/login adresinden api/secret al
# Production: https://merchant.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# Callback URL (Vercel domainine gore guncelle)
IYZICO_CALLBACK_URL=http://localhost:3000/api/payment/callback
