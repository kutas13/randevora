# Worker'in dinleyecegi port
PORT=3001

# Vercel'deki NOTIFY_WEBHOOK_SECRET ile AYNI olmali
# Bu degeri kimseyle paylasma!
NOTIFY_WEBHOOK_SECRET=cok-uzun-rastgele-bir-anahtar-buraya

# Baileys oturum klasoru (auto-oluşur)
AUTH_DIR=./auth

# Log seviyesi: trace | debug | info | warn | error
LOG_LEVEL=info
