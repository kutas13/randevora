# Worker'in dinleyecegi port
PORT=3001

# Vercel'deki NOTIFY_WEBHOOK_SECRET ile AYNI olmali
NOTIFY_WEBHOOK_SECRET=cok-uzun-rastgele-bir-anahtar-buraya

# Baileys oturum klasoru (auto-olusur)
AUTH_DIR=./auth

# Log seviyesi: trace | debug | info | warn | error
LOG_LEVEL=info

# Internal scheduler — worker, Randevora'nin cron endpoint'ini tetikler
# Bu sayede randevu hatirlatmalari dakika hassasiyetinde gonderilir.
RANDEVORA_URL=https://randevora.com.tr
CRON_SECRET=cron_v1_8mP2nQ7vY3xLkF9wHd5sJtBcZ6aRgUe1
SCHEDULER_INTERVAL_MS=60000
